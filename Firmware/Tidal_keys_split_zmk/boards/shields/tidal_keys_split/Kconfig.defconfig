if SHIELD_TIDAL_KEYS_SPLIT_LEFT

config ZMK_KEYBOARD_NAME
    default "tidal_keys"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # SHIELD_TIDAL_KEYS_SPLIT_LEFT

if SHIELD_TIDAL_KEYS_SPLIT_LEFT || SHIELD_TIDAL_KEYS_SPLIT_RIGHT

config ZMK_SPLIT
    default y

config ZMK_SPLIT_BLE
    default y

endif # SHIELD_TIDAL_KEYS_SPLIT_LEFT || SHIELD_TIDAL_KEYS_SPLIT_RIGHT
